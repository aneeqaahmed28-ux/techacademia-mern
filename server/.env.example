# Copy to server/.env and replace the secret. Never commit server/.env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/techacademia

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Access tokens are short. Refresh tokens rotate on use. Use 15m / 7, or Nm, Nh, Nd.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Comma-separated browser origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173

# true in production (HTTPS). SameSite=None also requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

BCRYPT_SALT_ROUNDS=10

# Login and registration are tighter than the general API limit.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CONTACT_MAX=20
RATE_LIMIT_API_MAX=300

# Set to 1 only behind a trusted reverse proxy. Leaving it on for a public server
# lets clients spoof X-Forwarded-For and bypass the rate limit.
TRUST_PROXY=0
